# Salin menjadi .env, lalu isi parameter koneksi PostgreSQL.
APP_PORT=9000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace-me
DB_NAME=gis_app
DB_SSLMODE=disable

# Gunakan nilai acak minimal 32 karakter. Cookie Secure aktif saat HTTPS.
AUTH_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:3000

# Email reset password: isi host relay/SMTP kantor sebelum fitur digunakan.
SMTP_HOST=
SMTP_PORT=587
# starttls (587), tls (465), atau none khusus relay internal tanpa autentikasi.
SMTP_TLS_MODE=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=AEP GIS System <auto.alert@aepplantations.id>

# Cron notifikasi akuisisi: testing memberi prefix subjek dan banner email.
NOTIFICATION_TEST_MODE=true
NOTIFICATION_TEST_TO=rizki.hamdani@aepplantations.id
NOTIFICATION_BATCH_SIZE=1
NOTIFICATION_BCC=
NOTIFICATION_REJECTED_CC=
# Gunakan domain/IP API yang dapat diakses pemindai QR sebelum PDF pertama dibuat.
PUBLIC_API_ORIGIN=http://localhost:9000

# Docker/Linux: gunakan path absolut yang di-bind mount ke container.
# ACQUISITION_UPLOADS_DIR=/data/uploads
# LEGACY_SUPPORTED_DOC_DIR=/data/legacy-uploads
# LEGACY_MEMO_DIR=/data/legacy-uploads/memo
# Dokumen lama tanpa SMB mount (default sama dengan nilai berikut).
LEGACY_DOCUMENT_URL=http://gis.aepplantations.id/doc/download_doc.php
LEGACY_DOCUMENT_PREVIEW_BASE_URL=http://gis.aepplantations.id/CI/assets/uploads
